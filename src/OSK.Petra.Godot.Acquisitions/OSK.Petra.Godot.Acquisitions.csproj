<Project Sdk="Godot.NET.Sdk/4.4.0">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<Description>Provides an implementation for configuration and related data structures for Acquisition items, tech, tech trees, etc..</Description>
		<PackageTags>OpenSourceKingdom, OpenSource, Petra, Game, Framework, Suite, Tool, Tech, Tree, Upgrade, Path, Acquire, Acquisition, Item, Provision, Definition, Godot</PackageTags>
		<Title>OSK.Petra.Godot.Acquisitions</Title>
		<Authors>BlankDev117</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/OpenSourceKingdom/OSK.Petra.Godot.Acquisitions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Required Godot injection -->
	<ItemGroup>
		<Compile Update="**\*.cs" Pack="true" PackagePath="godot\%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="..\OSK.Petra.Godot.targets" Pack="true" PackagePath="buildTransitive\$(MSBuildProjectName).targets" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="OSK.Extensions.Petra.Math.Provisions" Version="0.3.0" />
	  <PackageReference Include="OSK.Petra.Acquisitions" Version="0.1.0" />
	  <PackageReference Include="OSK.Petra.Godot.Math.Formulas" Version="0.1.0" />
	  <PackageReference Include="OSK.Petra.Godot.Primitives" Version="0.3.2" />
	  <PackageReference Include="OSK.Petra.Godot.Provisions" Version="0.1.0" />
	</ItemGroup>

</Project>
